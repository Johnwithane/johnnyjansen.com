# Firebase web config for the johnnyjansen-portal project (public client keys,
# guarded by rules, not secrecy). Copy to portal/.env for local dev.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=johnnyjansen-portal.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=johnnyjansen-portal
VITE_FIREBASE_APP_ID=
