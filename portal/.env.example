# Firebase web config for the familyhub-prod project (public client keys,
# guarded by rules, not secrecy). Copy to portal/.env for local dev.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=familyhub-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=familyhub-prod
VITE_FIREBASE_APP_ID=
# reCAPTCHA Enterprise site key for App Check. Leave empty locally.
VITE_RECAPTCHA_SITE_KEY=
