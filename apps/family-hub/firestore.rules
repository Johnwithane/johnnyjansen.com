rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------------
    // Tenant isolation, by construction (FAMILY_PLAN.md section 9.1).
    //
    // Every tenant document lives under households/{hid}. The signed-in
    // person's household and role ride on the ID token as custom claims,
    // set only by the household functions (createHousehold, acceptInvite).
    // Every rule below checks the claim FIRST, then the role, then
    // ownership for private items. There are no doc lookups.
    // ---------------------------------------------------------------------

    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function uid() { return request.auth.uid; }
    function inHousehold(h) { return signedIn() && request.auth.token.hid == h; }
    function isAdult(h) { return inHousehold(h) && request.auth.token.role == 'adult'; }
    // A session that passed a second factor. Money, Taxes and the Vault
    // (Phase 2+) require this on top of the household claim.
    function isMfa() {
      return request.auth.token.firebase.sign_in_second_factor != null;
    }

    match /households/{h} {
      // The household doc (name, members, settings) is readable by every
      // member. Only functions write it: membership and claims change
      // together or not at all.
      allow read: if inHousehold(h);
      allow create, update, delete: if false;

      match /invites/{inviteId} {
        allow read: if isAdult(h);
        allow create, update, delete: if false;
      }

      match /audit/{entryId} {
        allow read: if isAdult(h);
        allow create, update, delete: if false;
      }

      // Each member's slice of the family agenda (events from the calendars
      // they marked as family). Whole household reads; the sync writes.
      match /agenda/{memberUid} {
        allow read: if inHousehold(h);
        allow create, update, delete: if false;
      }

      // Bugs, ideas, improvements (FAMILY_PLAN.md 4.18). Any member files
      // one; the whole household reads the queue; adults triage status +
      // notes; shipped is set by CI through markFeedbackShipped, never here.
      match /feedback/{reportId} {
        // A screenshot path must sit in THIS household and THIS reporter's
        // folder. The me endpoint signs these with the admin SDK (which
        // ignores storage.rules), so the shape is enforced here, per element.
        function shotOk(l, i) {
          return l.size() <= i
            || (l[i] is string && l[i].matches('households/' + h + '/feedback/' + uid() + '/[^/]+'));
        }
        function validReport() {
          let d = request.resource.data;
          return d.type in ['bug', 'idea', 'improvement']
            && d.description is string && d.description.size() > 0 && d.description.size() <= 4000
            && d.status == 'open'
            && d.reporterUid == uid()
            && d.reportId == reportId
            && d.screenshotPaths is list && d.screenshotPaths.size() <= 3
            && shotOk(d.screenshotPaths, 0) && shotOk(d.screenshotPaths, 1) && shotOk(d.screenshotPaths, 2)
            && d.keys().hasOnly(['reportId', 'type', 'description', 'route', 'url', 'environment', 'appVersion', 'screenshotPaths', 'status', 'notes', 'reporterUid', 'reporterName', 'createdAt', 'updatedAt']);
        }
        allow read: if inHousehold(h);
        allow create: if inHousehold(h) && validReport();
        allow update: if isAdult(h)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'notes', 'updatedAt'])
          && request.resource.data.status in ['open', 'triaged', 'in_progress', 'wontfix'];
        allow delete: if false;
      }

      // The household's own calendar: bills, birthdays, renewals, trips,
      // and events intake proposed. Google events never live here; they
      // stay in each person's snapshot and agenda slice.
      match /events/{eventId} {
        function validEvent() {
          let d = request.resource.data;
          return d.title is string && d.title.size() > 0 && d.title.size() <= 200
            && d.start is string && d.start.size() >= 10 && d.start.size() <= 30
            && d.end is string && d.end.size() >= 10 && d.end.size() <= 30
            && d.allDay is bool
            && d.kind in ['event', 'bill', 'birthday', 'renewal', 'trip', 'school']
            && d.memberIds is list && d.memberIds.size() <= 12
            && d.ownerUid is string
            && d.keys().hasOnly(['title', 'start', 'end', 'allDay', 'kind', 'memberIds', 'location', 'notes', 'source', 'ownerUid', 'createdAt', 'updatedAt']);
        }
        allow read: if inHousehold(h);
        allow create: if inHousehold(h) && validEvent() && request.resource.data.ownerUid == uid();
        allow update: if inHousehold(h) && validEvent() && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if inHousehold(h) && (resource.data.ownerUid == uid() || isAdult(h));
      }

      // Machines propose, people confirm (PLAN.md section 5). Functions and
      // the laptop worker create suggestions; a member may only resolve one
      // (accept or dismiss), never create, edit or delete it. A private
      // suggestion (from someone's own inbox) is visible to that person only.
      match /suggestions/{suggestionId} {
        function visibleToMe() {
          return resource.data.visibility == 'household' || resource.data.ownerUid == uid();
        }
        allow read: if inHousehold(h) && visibleToMe();
        allow create, delete: if false;
        allow update: if inHousehold(h) && visibleToMe()
          && resource.data.status == 'pending'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'resolvedAt', 'resolvedBy'])
          && request.resource.data.status in ['accepted', 'dismissed']
          && request.resource.data.resolvedBy == uid();
      }

      // Money (PLAN.md 4.5). Accounts and transactions carry visibility like
      // tasks: shared by default, private ones to their owner only. Amounts
      // are positive numbers; direction says which way. Function-written
      // fields (import batches) are not distinguished yet; every member may
      // record a transaction they own. Money needs a session that passed
      // the second factor (PLAN.md 9.2): a child never reaches it, and an
      // adult who has not enrolled sees the Security screen first.
      match /accounts/{accountId} {
        function visibleAccount() { return resource.data.visibility == 'household' || resource.data.ownerUid == uid(); }
        function validAccount() {
          let d = request.resource.data;
          return d.name is string && d.name.size() > 0 && d.name.size() <= 80
            && d.type in ['chequing', 'savings', 'credit', 'cash', 'loan']
            && d.currency is string && d.currency.size() == 3
            && d.visibility in ['household', 'private']
            && d.ownerUid is string
            && d.keys().hasOnly(['name', 'type', 'currency', 'visibility', 'ownerUid', 'balance', 'createdAt', 'updatedAt']);
        }
        allow read: if isAdult(h) && isMfa() && visibleAccount();
        allow create: if isAdult(h) && isMfa() && validAccount() && request.resource.data.ownerUid == uid();
        allow update: if isAdult(h) && isMfa() && visibleAccount() && validAccount() && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if isAdult(h) && isMfa() && visibleAccount();
      }

      match /transactions/{txId} {
        function visibleTx() { return resource.data.visibility == 'household' || resource.data.ownerUid == uid(); }
        function validTx() {
          let d = request.resource.data;
          return d.amount is number && d.amount >= 0 && d.amount < 10000000
            && d.direction in ['expense', 'income']
            && d.date is string && d.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
            && d.merchant is string && d.merchant.size() <= 120
            && d.category is string && d.category.size() <= 40
            && d.taxCategory is string && d.taxCategory.size() <= 40
            && d.visibility in ['household', 'private']
            && d.ownerUid is string
            && d.source in ['portal', 'receipt', 'import', 'cli']
            && (d.receiptPath == null || (d.receiptPath is string && d.receiptPath.matches('households/' + h + '/receipts/' + uid() + '/[^/]+')))
            && d.keys().hasOnly(['amount', 'direction', 'date', 'merchant', 'category', 'taxCategory', 'accountId', 'businessId', 'receiptPath', 'notes', 'visibility', 'ownerUid', 'source', 'createdAt', 'updatedAt']);
        }
        allow read: if isAdult(h) && isMfa() && visibleTx();
        allow create: if isAdult(h) && isMfa() && validTx() && request.resource.data.ownerUid == uid();
        allow update: if isAdult(h) && isMfa() && visibleTx() && validTx() && request.resource.data.ownerUid == resource.data.ownerUid
          && request.resource.data.receiptPath == resource.data.receiptPath;
        allow delete: if isAdult(h) && isMfa() && visibleTx();
      }

      // Household settings docs (budget envelopes, later digest and paper
      // config). Adults write; everyone reads.
      match /settings/{settingId} {
        allow read: if inHousehold(h);
        allow create, update: if isAdult(h);
        allow delete: if false;
      }

      match /tasks/{taskId} {
        function visibleToMe() {
          return resource.data.visibility == 'household' || resource.data.ownerUid == uid();
        }
        function validTask() {
          let d = request.resource.data;
          return d.title is string && d.title.size() > 0 && d.title.size() <= 500
            && d.done is bool
            && d.visibility in ['household', 'private']
            && d.ownerUid is string
            && d.keys().hasOnly(['title', 'done', 'doneAt', 'due', 'notes', 'visibility', 'ownerUid', 'assigneeUid', 'source', 'createdAt', 'updatedAt']);
        }
        allow read: if inHousehold(h) && visibleToMe();
        allow create: if inHousehold(h) && validTask()
          && request.resource.data.ownerUid == uid()
          && request.resource.data.source == 'portal';
        // Anyone in the household can edit a shared task; only the owner can
        // touch a private one. Ownership never changes hands.
        allow update: if inHousehold(h) && visibleToMe() && validTask()
          && request.resource.data.ownerUid == resource.data.ownerUid;
        allow delete: if inHousehold(h)
          && (resource.data.ownerUid == uid() || (isAdult(h) && resource.data.visibility == 'household'));
      }
    }

    match /users/{u} {
      // Own profile only. hid and role live here as a mirror of the claims
      // and are function-written; the person may edit display fields.
      allow read: if signedIn() && uid() == u;
      allow create, delete: if false;
      allow update: if signedIn() && uid() == u
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['name', 'colour', 'digest', 'timeZone', 'setup', 'legal', 'updatedAt']);

      // Google grant (KMS-encrypted), me token hash: functions only.
      match /private/{doc} {
        allow read, write: if false;
      }
      // Personal inbox + calendar pull and the daily digest, written by
      // functions, readable by exactly one uid.
      match /snapshots/{doc} {
        allow read: if signedIn() && uid() == u;
        allow write: if false;
      }
      match /digests/{doc} {
        allow read: if signedIn() && uid() == u;
        allow write: if false;
      }
    }

    // me endpoint tokens: hash -> { uid, hid }. Function-only both ways.
    match /meTokens/{hash} {
      allow read, write: if false;
    }

    // Google OAuth state nonces (ten minutes, burned on use). Function-only.
    match /oauthStates/{hash} {
      allow read, write: if false;
    }

    // Per-household daily caps on paid calls. Function-only.
    match /rateLimits/{limitId} {
      allow read, write: if false;
    }
  }
}
