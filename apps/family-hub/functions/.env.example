# Copy to functions/.env (untracked). Read by defineString() at deploy time.
TIMEZONE=America/Vancouver
# Cloud KMS key that seals Google refresh tokens (create the ring + key first, HUMANTASKS.md).
KMS_KEY=projects/familyhub-prod/locations/us-central1/keyRings/familyhub/cryptoKeys/google-tokens
# Google OAuth for per-person connect (Phase 1c) is a Secret Manager secret:
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_ID
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_SECRET
# Vertex AI (Gemini) for receipts and documents. Defaults are fine.
VERTEX_MODEL=gemini-2.5-flash
VERTEX_LOCATION=us-central1
