rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    function inHousehold(h) { return signedIn() && request.auth.token.hid == h; }

    // Every object path starts with the household. No public reads anywhere
    // (FAMILY_PLAN.md 9.4).
    match /households/{h}/feedback/{u}/{file} {
      allow read: if inHousehold(h);
      allow create: if inHousehold(h) && request.auth.uid == u
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    // Receipt photos, one folder per person inside the household. Money
    // needs an adult who passed the second factor, same as the Firestore side.
    match /households/{h}/receipts/{u}/{file} {
      allow read: if inHousehold(h) && request.auth.token.role == 'adult' && request.auth.token.firebase.sign_in_second_factor != null;
      allow create: if inHousehold(h) && request.auth.token.role == 'adult' && request.auth.token.firebase.sign_in_second_factor != null && request.auth.uid == u
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*') || request.resource.contentType == 'application/pdf');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
