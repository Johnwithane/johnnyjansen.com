# Copy to functions/.env (untracked). Read by defineString() at deploy time.
OWNER_EMAIL=you@example.com
TIMEZONE=America/Vancouver
# Secrets are NOT env vars. Set them once in Secret Manager:
#   firebase functions:secrets:set ME_TOKEN
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_ID
#   firebase functions:secrets:set GOOGLE_OAUTH_CLIENT_SECRET
#   firebase functions:secrets:set GOOGLE_OAUTH_REFRESH_TOKEN
