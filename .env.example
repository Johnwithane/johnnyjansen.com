# Google Analytics 4 measurement id. Empty disables analytics entirely.
NUXT_PUBLIC_GTAG_ID=
# Where the contact form posts. Formspree endpoint today; the SiteMason lead
# function later. Empty renders the form with a mailto fallback.
NUXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/mvgwbyvp
# The lab's Firebase project (client config from the console, all public).
# All empty = the lab shows "not configured" and the portfolio still builds.
NUXT_PUBLIC_FIREBASE_API_KEY=
NUXT_PUBLIC_FIREBASE_AUTH_DOMAIN=johnnyjansen-com.firebaseapp.com
NUXT_PUBLIC_FIREBASE_PROJECT_ID=johnnyjansen-com
NUXT_PUBLIC_FIREBASE_STORAGE_BUCKET=johnnyjansen-com.firebasestorage.app
NUXT_PUBLIC_FIREBASE_APP_ID=
